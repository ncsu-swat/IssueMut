+      // Must be an identifier
+      if (token.type !in identifierTokenType) {
+        continue
+      }
+      
+      // Check if followed by '(' - if so, it's a function call, not a variable
+      var isFollowedByParen = false
+      for (j in i + 1 until minOf(i + 3, tokens.size)) {
+        val nextToken = tokens[j]
+        if (nextToken.text == "(") {
+          isFollowedByParen = true
+          break
+        }
+        // Stop if we hit something other than whitespace
+        if (nextToken.text !in setOf(" ", "\n", "\t", "\r")) {
+          break
+        }
+      }
+      
+      if (!isFollowedByParen) {
+        // Additional heuristic: check if it's in an expression context via the tree
+        if (isInExpressionContext(i)) {
+          varRefIndices.add(i)
+        }
+      }
+    }
+    
+    return varRefIndices
+  }
