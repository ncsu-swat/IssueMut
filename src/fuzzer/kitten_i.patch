+  private fun isInExpressionContext(tokenIndex: Int): Boolean {
+    // Find the node in flattenedTree that contains this token
+    val token = seedProgram.tokens[tokenIndex]
+    
+    for (node in flattenedTree) {
+      if (!node.isTokenNode()) continue
+      
+      // Check if this node's token matches
+      val nodeBeginToken = node.beginToken?.token
+      val nodeEndToken = node.endToken?.token
+      
+      if (nodeBeginToken == token || nodeEndToken == token) {
+        val parent = node.parent ?: continue
+        val parentRuleName = parent.antlrRule?.ruleName?.lowercase() ?: ""
+        
+        return parentRuleName.contains("expression") ||
+              parentRuleName.contains("statement") ||
+              parentRuleName.contains("initializer")
+      }
+    }
+    
+    return true // Default to true if we can't determine
+  }
